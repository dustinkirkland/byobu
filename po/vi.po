#: bin/menu:34 byobu-config:129 byobu-config:401 byobu-config:409
msgid "Menu"
msgstr "Trình đơn"

#: byobu-export:68 byobu-export:71 byobu-select-profile:104
#: byobu-select-profile:107
msgid "Choose"
msgstr "Chọn"

#: byobu-export:171
msgid "File exists"
msgstr "Tệp đã tồn tại"

#: byobu-export:172
msgid "Remove file? [y/N] "
msgstr "Xóa tệp? [y/N] "

#: byobu-export:199
msgid "Select a color: "
msgstr "Chọn màu: "

#: byobu-export:240
msgid "Profile"
msgstr "Hồ sơ"

#: byobu-export:241
msgid "Archive"
msgstr "Tệp lưu trữ"

#: byobu-export:243
msgid "Extract the archive in your home directory on the target system."
msgstr "Hãy giải nén tệp lưu trữ vào thư mục chính của bạn trên hệ thống đích."

#: byobu-select-profile:49
msgid "Error:"
msgstr "Lỗi:"

#: byobu-select-profile:49
msgid " file exists, but is not a symlink"
msgstr " tồn tại nhưng không phải là liên kết tượng trưng"

#: byobu-select-profile:80
msgid "Select a screen profile: "
msgstr "Chọn hồ sơ screen: "

#: byobu-select-profile:97
msgid "ERROR: Invalid selection"
msgstr "LỖI: Lựa chọn không hợp lệ"

#: byobu-select-profile:134
msgid ""
"If you are using the default set of keybindings, press\\n<F5> to activate "
"these changes.\\n\\nOtherwise, exit this screen session and start a new one."
msgstr ""
"Nếu bạn đang dùng bộ tổ hợp phím mặc định, hãy nhấn\\n<F5> để áp dụng các "
"thay đổi này.\\n\\nNếu không, hãy thoát phiên screen này và bắt đầu một phiên "
"mới."

#: byobu-select-profile:136
msgid "Run \"byobu\" to activate"
msgstr "Chạy \"byobu\" để kích hoạt"

#: byobu-config:83
msgid "Byobu currently launches at login (toggle off)"
msgstr "Byobu hiện đang khởi chạy khi đăng nhập (chọn để tắt)"

#: byobu-config:85
msgid "Byobu currently does not launch at login (toggle on)"
msgstr "Byobu hiện không khởi chạy khi đăng nhập (chọn để bật)"

#: byobu-config:89
msgid "Help"
msgstr "Trợ giúp"

#: byobu-config:90
msgid "Change Byobu's colors"
msgstr "Đổi màu của Byobu"

#: byobu-config:91
msgid "Toggle status notifications"
msgstr "Bật/tắt thông báo trạng thái"

#: byobu-config:92
msgid "Change keybinding set"
msgstr "Đổi bộ tổ hợp phím"

#: byobu-config:93
msgid "Change escape sequence"
msgstr "Đổi phím escape"

#: byobu-config:94
msgid "Create new windows"
msgstr "Tạo cửa sổ mới"

#: byobu-config:95
msgid "Manage default windows"
msgstr "Quản lý cửa sổ mặc định"

#: byobu-config:99 byobu-config:487
msgid " Byobu Configuration Menu"
msgstr " Trình đơn cấu hình Byobu"

#: byobu-config:110
msgid "Okay"
msgstr "Đồng ý"

#: byobu-config:110 byobu-config:144 byobu-config:161 byobu-config:195
#: byobu-config:335 byobu-config:376 byobu-config:449
msgid "Cancel"
msgstr "Hủy"

#: byobu-config:130
msgid "Byobu Help"
msgstr "Trợ giúp Byobu"

#: byobu-config:144 byobu-config:161 byobu-config:195 byobu-config:335
#: byobu-config:376 byobu-config:449
msgid "Apply"
msgstr "Áp dụng"

#: byobu-config:146
msgid "Which profile would you like to use?"
msgstr "Bạn muốn dùng hồ sơ nào?"

#: byobu-config:162
msgid "Which set of keybindings would you like to use?"
msgstr "Bạn muốn dùng bộ tổ hợp phím nào?"

#: byobu-config:175
msgid "Title: "
msgstr "Tiêu đề: "

#: byobu-config:177
msgid "Command: "
msgstr "Lệnh: "

#: byobu-config:179
msgid "Presets: "
msgstr "Thiết lập sẵn: "

#: byobu-config:193
msgid "Add to default windows"
msgstr "Thêm vào cửa sổ mặc định"

#: byobu-config:197
msgid "Create new window(s):"
msgstr "Tạo cửa sổ mới:"

#: byobu-config:336
msgid "Toggle status notifications:"
msgstr "Bật/tắt thông báo trạng thái:"

#: byobu-config:368
msgid "Windows:"
msgstr "Cửa sổ:"

#: byobu-config:378
msgid "Select window(s) to create by default:"
msgstr "Chọn các cửa sổ sẽ được tạo mặc định:"

#: byobu-config:398
msgid "Byobu will be launched automatically next time you login."
msgstr "Byobu sẽ tự động khởi chạy vào lần đăng nhập tới."

#: byobu-config:406
msgid "Byobu will not be used next time you login."
msgstr "Byobu sẽ không được dùng vào lần đăng nhập tới."

#: byobu-config:408
msgid "Message"
msgstr "Thông báo"

#: byobu-config:448
msgid "Escape key: ctrl-"
msgstr "Phím escape: ctrl-"

#: byobu-config:451
msgid "Change escape sequence:"
msgstr "Đổi phím escape:"

#: byobu-config:488
msgid "<Tab>/<Alt-Tab> between elements | <Enter> selects | <Esc> exits"
msgstr "<Tab>/<Alt-Tab> chuyển giữa các thành phần | <Enter> chọn | <Esc> thoát"
