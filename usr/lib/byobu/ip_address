__ip_address_detail() {
	if [ -x /sbin/ip ]; then
		/sbin/ip -4 addr list
		/sbin/ip -6 addr list
	fi
}

___ip_address_refresh() {
	local cache="$1" tmp="$1.$$"
	shift
	(
		ip=$("$@" </dev/null 2>/dev/null)
		[ -n "$ip" ] || exit 0
		{ printf "%s\n" "$ip" > "$tmp" && mv -f "$tmp" "$cache"; } || rm -f "$tmp"
	) </dev/null >/dev/null 2>&1 &
}

___ip_address_external4() {
	local ip=
	if [ -n "$EXTERNAL_IP_SOURCE" ]; then
		# User-specified URL (e.g. https://api.ipify.org). LP: #1869483
		ip=$(timeout 1 wget -q -O- "$EXTERNAL_IP_SOURCE")
	elif command -v dig >/dev/null 2>&1; then
		# Try dig with OpenDNS first (faster), fall back to wget
		ip=$(timeout 1 dig +short myip.opendns.com @resolver1.opendns.com)
	fi
	# Fall back to wget if primary source didn't work
	[ -n "$ip" ] || ip=$(timeout 1 wget -q -O- http://v4.ipv6-test.com/api/myip.php)
	printf "%s" "$ip"
}

__ip_address() {
	local interface ipaddr cache="$BYOBU_RUN_DIR/cache.$BYOBU_BACKEND/ip_address" cache6="$BYOBU_RUN_DIR/cache.$BYOBU_BACKEND/ip_address6"
	# Allow interface overrides in $BYOBU_CONFIG_DIR/statusrc
	if [ -n "$MONITORED_NETWORK" ]; then
		interface="$MONITORED_NETWORK"
	else
		case "$IPV6" in
			1|true|yes)
				if [ -r /proc/net/ipv6_route ]; then
					interface=$(awk '$10 != "lo" { iface=$10 ; }; END { print iface; }' /proc/net/ipv6_route)
				else
					get_network_interface; interface="$_RET"
				fi
			;;
			*) get_network_interface; interface="$_RET";;
		esac
	fi
	case "$IPV6" in
		1|true|yes)
			if [ "$IP_EXTERNAL" = "1" ]; then
				# Background an update
				___ip_address_refresh "$cache6" timeout 1 wget -q -O- http://v6.ipv6-test.com/api/myip.php
				# Brief sleep for cold-start display optimization (requires bash)
				sleep 0.02
				[ -s "$cache6" ] && read ipaddr < "$cache6"
			else
				if [ -x /sbin/ip ]; then
					ipaddr=$(LC_ALL=C /sbin/ip -6 addr list dev "$interface" scope global 2>/dev/null)
				elif eval $BYOBU_TEST ifconfig >/dev/null 2>&1; then
					ipaddr=$(LC_ALL=c ifconfig "$interface" | grep "inet6 " | awk '{print $2}' | sed -e "s/%.*//" | head -n 1)

				fi
			fi
			# Print 'None' if we have no global address
			[ -z "$ipaddr" ] && ipaddr="None"
			ipaddr=${ipaddr#* inet6 }
			ipaddr=${ipaddr%%/*}
		;;
		*)
			if [ "$IP_EXTERNAL" = "1" ]; then
				___ip_address_refresh "$cache" ___ip_address_external4
				# Brief sleep for cold-start display optimization (requires bash)
				sleep 0.1
				[ -s "$cache" ] && read ipaddr < "$cache"
			elif metadata_available; then
				# We're in EC2, so get our public IP address
				___ip_address_refresh "$cache" timeout 0.2 wget -q -O- http://169.254.169.254/latest/meta-data/public-ipv4
				# Brief sleep for cold-start display optimization (requires bash)
				sleep 0.02
				[ -s "$cache" ] && read ipaddr < "$cache"
			else
				if [ -x /sbin/ip ]; then
					# 'ip route get' reports the preferred source for outbound
					# traffic without needing to guess the interface. LP: #2015819
					# But an explicit MONITORED_NETWORK (eg. tun0) wins. LP: #1918295
					[ -n "$MONITORED_NETWORK" ] || ipaddr=$(LC_ALL=C /sbin/ip route get 1.1.1.1 2>/dev/null | \
						awk '/src/{for(i=1;i<=NF;i++) if($i=="src"){print $(i+1); exit}}')
					# Fall back to interface-based detection (no default route, VPN, etc.)
					if [ -z "$ipaddr" ]; then
						ipaddr=$(LC_ALL=C /sbin/ip -4 addr list dev "$interface" scope global 2>/dev/null)
						ipaddr=${ipaddr#* inet }
						ipaddr=${ipaddr%%/*}
					fi
				elif eval $BYOBU_TEST ifconfig >/dev/null 2>&1; then
					ipaddr=$(ifconfig "$interface" | grep "inet " | awk '{print $2}')
				fi
			fi
		;;
	esac
	if [ -n "$ipaddr" ]; then
		if [ "$1" = "t" ]; then
			printf "%s" "$ipaddr"
		else
			color b w k; printf "%s" "$ipaddr"; color --
		fi
	fi
}

